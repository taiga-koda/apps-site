{
  "permissions": {
    "allow": [
      "Bash(git fetch *)",
      "Bash(git fetch)",
      "Bash(git branch --show-current)",
      "Bash(git push -u origin HEAD)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git merge-base:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)"
    ],
    "deny": [
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git * push * main)",
      "Bash(git * push * main *)",
      "Bash(git * push *:main)",
      "Bash(git * push *:main *)",
      "Bash(git push *refs/heads/main)",
      "Bash(git push *refs/heads/main *)",
      "Bash(git * push *refs/heads/main)",
      "Bash(git * push *refs/heads/main *)",
      "Bash(git push * dev)",
      "Bash(git push * dev *)",
      "Bash(git push *:dev)",
      "Bash(git push *:dev *)",
      "Bash(git * push * dev)",
      "Bash(git * push * dev *)",
      "Bash(git * push *:dev)",
      "Bash(git * push *:dev *)",
      "Bash(git push *refs/heads/dev)",
      "Bash(git push *refs/heads/dev *)",
      "Bash(git * push *refs/heads/dev)",
      "Bash(git * push *refs/heads/dev *)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.keystore)",
      "Read(./**/*.jks)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard-dangerous-ops.sh"
          }
        ]
      }
    ]
  }
}
